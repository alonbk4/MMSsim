{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "44rem",
			"wideSize": "76rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Paper", "color": "#f5f0e6" },
				{ "slug": "panel", "name": "Sand", "color": "#ece4d3" },
				{ "slug": "sage", "name": "Sage", "color": "#dde5cc" },
				{ "slug": "line", "name": "Line", "color": "#d8cdb6" },
				{ "slug": "contrast", "name": "Ink", "color": "#1d2a21" },
				{ "slug": "muted", "name": "Muted ink", "color": "#5a6253" },
				{ "slug": "forest", "name": "Forest", "color": "#1f3a2b" },
				{ "slug": "accent", "name": "Moss", "color": "#3f6b36" },
				{ "slug": "clay", "name": "Clay", "color": "#b4532a" },
				{ "slug": "straw", "name": "Straw", "color": "#e2b04a" },
				{ "slug": "on-accent", "name": "White", "color": "#ffffff" },
				{ "slug": "soil", "name": "Soil", "color": "#2b241c" },
				{ "slug": "works", "name": "Works here", "color": "#2f6b2a" },
				{ "slug": "partial", "name": "Partly worked", "color": "#8a5a00" },
				{ "slug": "failed", "name": "Didn’t work", "color": "#9b2c1f" },
				{ "slug": "researched", "name": "Researched", "color": "#3e5a7a" },
				{ "slug": "unproven", "name": "Unproven", "color": "#6b5b7a" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 3vw, 2rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2.25rem, 5vw, 4rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3.5rem, 9vw, 7.5rem)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Instrument Sans",
					"fontFamily": "\"Instrument Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{ "fontFamily": "Instrument Sans", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-sans-latin-wght-normal.woff2" ] },
						{ "fontFamily": "Instrument Sans", "fontStyle": "italic", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/instrument-sans-latin-wght-italic.woff2" ] }
					]
				},
				{
					"slug": "heading",
					"name": "Fraunces",
					"fontFamily": "Fraunces, \"Iowan Old Style\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-latin-full-normal.woff2" ] },
						{ "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-latin-full-italic.woff2" ] }
					]
				},
				{
					"slug": "mono",
					"name": "IBM Plex Mono",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
					"fontFace": [
						{ "fontFamily": "IBM Plex Mono", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-mono-latin-400-normal.woff2" ] },
						{ "fontFamily": "IBM Plex Mono", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-mono-latin-500-normal.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Label", "size": "0.75rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Body", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Lead", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Heading", "size": "2.5rem", "fluid": { "min": "1.85rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Title", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" } },
				{ "slug": "display", "name": "Display", "size": "5.25rem", "fluid": { "min": "2.75rem", "max": "5.25rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "max(16px, var(--wp--preset--spacing--40))",
				"right": "max(16px, var(--wp--preset--spacing--40))"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--clay)" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"lineHeight": "1.08",
					"letterSpacing": "-0.015em"
				},
				"color": { "text": "var(--wp--preset--color--contrast)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "letterSpacing": "-0.025em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" }, "spacing": { "margin": { "top": "3rem" } } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.25" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--clay)",
					"text": "var(--wp--preset--color--on-accent)"
				},
				"border": { "radius": "999px" },
				"typography": { "fontWeight": "600", "fontSize": "1rem", "letterSpacing": "0.005em" },
				"spacing": { "padding": { "top": "0.95rem", "bottom": "0.95rem", "left": "1.6rem", "right": "1.6rem" } },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast)" } }
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "fontSize": "1.3rem", "letterSpacing": "-0.01em" },
				"elements": { "link": { "color": { "text": "currentColor" }, "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "0.975rem", "fontWeight": "500" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/post-date": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--x-small)", "textTransform": "uppercase", "letterSpacing": "0.08em" },
				"color": { "text": "var(--wp--preset--color--muted)" }
			},
			"core/post-terms": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--x-small)", "textTransform": "uppercase", "letterSpacing": "0.08em" }
			},
			"core/post-excerpt": {
				"color": { "text": "var(--wp--preset--color--muted)" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--clay)", "width": "3px" } },
				"spacing": { "padding": { "left": "1.5rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "var(--wp--preset--font-size--large)", "fontStyle": "italic" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Page without title", "postTypes": [ "page" ] }
	]
}
